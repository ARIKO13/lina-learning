generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  googleId      String        @unique
  email         String        @unique
  name          String
  image         String?
  xp            Int           @default(0)
  level         Int           @default(1)
  streak        Int           @default(0)
  lastActiveAt  DateTime?
  currentSeason Int           @default(1)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  dailyProgress  DailyProgress[]
  monthlyRecaps  MonthlyRecap[]
  yearlyRecords  YearlyRecord[]
  certificates   Certificate[]
}

model DailyProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        String
  topic       String
  score       Int
  xpEarned    Int
  questionsCount Int
  correctCount   Int
  timeSpentSeconds Int
  createdAt   DateTime @default(now())

  @@unique([userId, date])
}

model MonthlyRecap {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  yearMonth     String
  totalXP       Int      @default(0)
  totalDays     Int      @default(0)
  avgScore      Float    @default(0)
  bestScore     Int      @default(0)
  topicsCovered String
  level         Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([userId, yearMonth])
}

model YearlyRecord {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year          String
  season        Int
  totalXP       Int      @default(0)
  totalDays     Int      @default(0)
  avgScore      Float    @default(0)
  maxLevel      Int      @default(0)
  maxStreak     Int      @default(0)
  completed     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@unique([userId, year, season])
}

model Certificate {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  season        Int
  year          String
  totalXP       Int
  totalDays     Int
  maxLevel      Int
  maxStreak     Int
  awardedAt     DateTime @default(now())
  expiresAt     DateTime
  shareCode     String   @unique
}
