ransparent 100%);\">\n                \n                <!-- Overlay to make it look more like the drawing if needed, but keeping it simple for structure -->\n                <div class=\"absolute inset-0 bg-white/10 mix-blend-overlay\"></div>\n            </div>\n        </div>\n    </header>\n\n    <main class=\"max-w-4xl mx-auto px-6 space-y-24 py-12\">\n\n        <!-- SECTION 1: WHY STRATEGISTS LOVE IDEAAPE -->\n        <section id=\"features\">\n            <div class=\"section-divider text-xs font-bold uppercase tracking-widest text-gray-500\">\n                Features\n            </div>\n\n            <h2 class=\"font-serif text-4xl text-black mb-6\">Why strategists love IdeaApe</h2>\n            \n            <div class=\"space-y-6 text-gray-700 leading-relaxed\">\n                <p class=\"font-medium\">\n                    AI responses are based on aggregated training data, not real-time, diverse opinions.\n                </p>\n                <p class=\"font-bold text-black text-lg\">\n                    IdeaApe answers strictly from firsthand knowledge.\n                </p>\n                <p>\n                    By using Reddit as a data source, you will never miss the nuances of any brand, culture, category, or product.\n                </p>\n            </div>\n\n            <!-- Blurred UI Cards (The \"App Preview\") -->\n            <div class=\"mt-16 relative h-[400px] w-full flex items-center justify-center\">\n                <!-- Background blurred cards simulating the UI screenshot in original image -->\n                <div class=\"absolute top-0 left-0 w-64 h-40 bg-white rounded-xl shadow-xl blur-card border border-gray-100 p-4 transform -rotate-6 translate-x-10\">\n                    <div class=\"h-4 w-32 bg-gray-200 rounded mb-4\"></div>\n                    <div class=\"h-3 w-full bg-gray-100 rounded mb-2\"></div>\n                    <div class=\"h-3 w-2/3 bg-gray-100 rounded mb-4\"></div>\n                    <div class=\"h-8 w-24 bg-orange-400 rounded-lg opacity-50\"></div>\n                </div>\n\n                <div class=\"absolute bottom-10 right-0 w-72 h-48 bg-white rounded-xl shadow-xl blur-card border border-gray-100 p-4 transform rotate-3 -translate-x-10\">\n                     <div class=\"h-4 w-40 bg-gray-200 rounded mb-4\"></div>\n                     <div class=\"space-y-2\">\n                         <div class=\"h-3 w-full bg-blue-50 rounded\"></div>\n                         <div class=\"h-3 w-full bg-orange-50 rounded\"></div>\n                         <div class=\"h-3 w-3/4 bg-gray-50 rounded\"></div>\n                     </div>\n                </div>\n                \n                <div class=\"absolute top-20 left-1/3 w-56 h-36 bg-white rounded-xl shadow-lg blur-card border border-gray-100 transform -rotate-2\"></div>\n            </div>\n        </section>\n\n        <!-- SECTION 2: DISCOVERING HIDDEN NARRATIVES -->\n        <section id=\"learn-more\">\n            <div class=\"section-divider text-xs font-bold uppercase tracking-widest text-gray-500\">\n                Learn More\n            </div>\n\n            <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-12 items-start\">\n                <div>\n                    <h2 class=\"font-serif text-4xl text-black mb-6 leading-tight\">\n                        Discovering Hidden Narratives With AI\n                    </h2>\n                    \n                    <p class=\"text-gray-700 leading-relaxed mb-8\">\n                        Watch Ash explain how AI tools like IdeaApe can help you uncover hidden narratives and build detailed personas based on real, unfiltered voices from niche communities.\n                    </p>\n\n                    <button class=\"bg-brand-orange hover:bg-orange-600 text-white font-medium py-3 px-8 rounded-full shadow-lg shadow-orange-200 transition\">\n                        Watch full course\n                    </button>\n                </div>\n\n                <!-